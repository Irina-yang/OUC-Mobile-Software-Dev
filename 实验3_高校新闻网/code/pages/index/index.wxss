page {
  background-color: transparent; 
}

/* ================= 视觉核心：全局背景 ================= */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -2;
  filter: blur(4px); 
  transform: scale(1.1); 
}

.page-bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  background-color: rgba(240, 248, 255, 0.2); 
}

/* 顶部区域整体下移 */
.header-container {
  padding: 120rpx 30rpx 30rpx 30rpx;
  position: relative;
  z-index: 10;
}

/* 修改：整体 Logo 排版 */
.brand-box {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx; 
  padding-left: 10rpx;
}
.brand-logo {
  height: 80rpx; /* 固定高度，宽度会自动等比展开 */
  filter: drop-shadow(0 2rpx 8rpx rgba(0,0,0,0.3)); /* 增加微弱阴影，防止在白底背景上看不清 */
}

.search-box {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.65); 
  backdrop-filter: blur(8px);
  border-radius: 40rpx;
  padding: 12rpx 30rpx;
  height: 64rpx;
  box-shadow: 0 6rpx 20rpx rgba(135, 206, 250, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 15rpx;
  color: #333333;
}

/* 搜索历史 */
.search-history { padding: 0 30rpx 30rpx 30rpx; }
.history-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.history-header .title { font-size: 30rpx; color: #333; font-weight: bold; }
.history-header .clear-btn { font-size: 24rpx; color: #888; }
.history-tags { display: flex; flex-wrap: wrap; gap: 20rpx; }
.history-tags .tag { 
  background-color: rgba(255, 255, 255, 0.5); 
  backdrop-filter: blur(4px);
  color: #333; font-size: 24rpx; padding: 12rpx 28rpx; 
  border-radius: 30rpx; border: 1rpx solid rgba(255,255,255,0.6);
}

/* 幻灯片 */
.banner-swiper {
  height: 360rpx;
  margin: 0 30rpx 20rpx 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(135, 206, 250, 0.3);
}
.slide-image { width: 100%; height: 100%; object-fit: cover; }

/* 专题分类导航 */
.category-nav {
  display: flex; 
  white-space: nowrap; 
  padding: 10rpx 30rpx 20rpx 30rpx;
  box-sizing: border-box;
}
.cat-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: #333;
  background-color: rgba(255, 255, 255, 0.45); 
  backdrop-filter: blur(8px);
  border-radius: 40rpx;
  margin-right: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}
.cat-item.active {
  background-color: rgba(135, 206, 250, 0.9); 
  color: #FFFFFF;
  font-weight: bold;
  border-color: #87CEFA;
  box-shadow: 0 6rpx 16rpx rgba(135, 206, 250, 0.4);
}

/* 新闻列表毛玻璃卡片 */
#news-list { padding: 10rpx 30rpx 40rpx 30rpx; }
.news-card {
  display: flex;
  background-color: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  transition: transform 0.2s;
}
.news-card:active { transform: scale(0.97); }

.news-poster {
  width: 240rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.news-info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
}
.news-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #111; 
  line-height: 46rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.news-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.news-tag {
  font-size: 20rpx;
  color: #007bb5; 
  background-color: rgba(135, 206, 250, 0.3);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}
.news-date { font-size: 22rpx; color: #555; }

.empty-tip { text-align: center; color: #555; font-size: 28rpx; margin-top: 100rpx; }

/* 回到顶部悬浮按钮 */
.back-top-btn {
  position: fixed; right: 40rpx; bottom: 80rpx; width: 88rpx; height: 88rpx;
  background-color: #87CEFA;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(135, 206, 250, 0.5); opacity: 0; visibility: hidden;
  transform: translateY(20rpx); transition: all 0.3s ease-in-out; z-index: 999;
}
.back-top-btn.show { opacity: 1; visibility: visible; transform: translateY(0); }
.back-top-btn .arrow { color: #FFFFFF; font-size: 40rpx; font-weight: bold; }