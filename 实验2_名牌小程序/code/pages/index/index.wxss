page {
  background-color: #eaf4fc; 
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头图样式 */
.header-image {
  width: 100vw;
  height: 56.25vw; 
  background-color: #e0e6ed; /* 图片未加载时的占位色 */
}

/* 个人信息卡片 */
.info-card {
  width: 90%;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-top: -60rpx; 
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  z-index: 1;
}

.name {
  font-size: 48rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #88929b;
}

.divider {
  height: 2rpx;
  background-color: #f0f0f0;
  margin: 40rpx 0;
}

.contact-item {
  display: flex;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  align-items: center;
}

.label {
  color: #a0aab5;
  width: 140rpx;
}

.value {
  color: #4a5560;
}

/* 标签 */
.tags-section {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 40rpx;
}

.tag {
  background-color: #eff3f7;
  color: #5c728a;
  padding: 10rpx 28rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
}