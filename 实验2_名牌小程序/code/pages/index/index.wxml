<view class="container">
  <!-- 上半部分：头图 -->
  <image class="header-image" src="/images/header.jpg" mode="aspectFill"></image>

  <!-- 下半部分：自定义个人信息卡片 -->
  <view class="info-card">
    
    <!-- 姓名与专业信息 -->
    <view class="header-info">
      <text class="name">{{name}}</text>
      <text class="subtitle">{{school}} | {{major}}</text>
    </view>

    <view class="divider"></view>

    <!-- 联系方式 -->
    <view class="contact-info">
      <view class="contact-item">
        <text class="label">Email</text>
        <text class="value">{{email}}</text>
      </view>
      <view class="contact-item">
        <text class="label">GitHub</text>
        <text class="value">{{github}}</text>
      </view>
    </view>

    <!-- 个人标签 -->
    <view class="tags-section">
      <block wx:for="{{tags}}" wx:key="*this">
        <view class="tag">{{item}}</view>
      </block>
    </view>

  </view>
</view>