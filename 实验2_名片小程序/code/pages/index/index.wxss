page {
  background-color: #eaf4fc;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  height: 100vh; 
}

.scroll-container {
  height: 100vh; 
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头图样式 */
.header-image {
  width: 100vw;
  height: 56.25vw; 
  background-color: #e0e6ed;
  margin-top: 100rpx;
}

/* 个人信息卡片 */
.info-card {
  width: 90%;
  background-color: #ffffff;
  border-radius: 20rpx;

  margin: 30rpx auto 0 auto; 
  
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  z-index: 2;
  position: relative;
  flex-shrink: 0;  
}

.name {
  font-size: 48rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #88929b;
}

.divider {
  height: 2rpx;
  background-color: #f0f0f0;
  margin: 40rpx 0;
}

.contact-item {
  display: flex;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  align-items: center;
}

.label {
  color: #a0aab5;
  width: 140rpx;
}

.value {
  color: #4a5560;
}

/* 标签 */
.tags-section {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 40rpx;
}

.tag {
  background-color: #eff3f7;
  color: #5c728a;
  padding: 10rpx 28rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
}

/* 百科卡片样式 */
.baike-card {
  width: 90%;
  background-color: #ffffff;
  border-radius: 20rpx;

  margin: 40rpx auto 120rpx auto; 
  
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
  flex-shrink: 0; 
}

.baike-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.baike-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 20rpx;
}

.baike-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(to right, #d4e6f6, transparent);
}

.experience-item {
  margin-bottom: 36rpx;
}

.experience-item:last-child {
  margin-bottom: 0;
}

.exp-category {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #4a5560;
  margin-bottom: 16rpx;
}

.dot-icon {
  width: 12rpx;
  height: 12rpx;
  background-color: #7ba2c6; 
  border-radius: 50%;
  margin-right: 12rpx;
}

.exp-details {
  padding-left: 24rpx; 
  border-left: 2rpx dashed #e0e6ed; 
  margin-left: 5rpx;
}

.detail-text {
  font-size: 26rpx;
  color: #66707a;
  line-height: 1.6;
  margin-bottom: 12rpx;
  text-align: justify;
}

.detail-text:last-child {
  margin-bottom: 0;
}