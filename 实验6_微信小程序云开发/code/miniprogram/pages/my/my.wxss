.page-container {
  min-height: 100vh;
  background-color: #ffffff; /* 未登录时采用纯白背景，符合大牌登录页规范 */
  padding-bottom: 60rpx;
}

/* --- 模仿小红书风格的登录页布局 --- */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 90vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-top: 40rpx;
}
.logo-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #ff2442; /* 标志性红 */
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.login-subtitle {
  font-size: 28rpx;
  color: #888888;
}

/* 中部表单区 */
.login-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}
/* 修复：强制正圆形，绝不被压扁 */
.avatar-wrapper {
  padding: 0;
  width: 160rpx !important;
  height: 160rpx !important;
  min-height: 160rpx !important;
  max-height: 160rpx !important;
  border-radius: 50% !important;
  border: 4rpx solid #f0f0f0;
  background-color: #fafafa;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.avatar-wrapper::after { border: none; }

.avatar {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  display: block;
}
.avatar-mask {
  position: absolute;
  bottom: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 4rpx 0;
}
.avatar-tip {
  font-size: 24rpx;
  color: #bbbbbb;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 85%;
  height: 90rpx;
  background: #f7f7f7;
  border-radius: 45rpx;
  padding: 0 40rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  color: #333;
  margin-bottom: 30rpx;
  border: 1rpx solid #eeeeee;
}
.input-placeholder {
  color: #cccccc;
}

.login-btn {
  width: 85%;
  height: 90rpx;
  background-color: #ff2442;
  color: #ffffff;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 36, 66, 0.25);
  margin-top: 10rpx;
}
.login-btn::after { border: none; }

/* 底部协议与帮助 */
.login-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-bottom: 20rpx;
}
.agreement-row {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 20rpx;
}
.radio-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}
.help-link {
  font-size: 24rpx;
  color: #576b95;
}

/* 背景图添加点击提示和统计栏样式 */
.header-section {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
}
.change-bg-tip {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.4);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  z-index: 3;
}
.stats-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 26rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.4);
}
.stat-divider {
  margin: 0 20rpx;
  opacity: 0.6;
}

/* --- 已登录后的个人主页样式 (保持原样高质量) --- */
.header-section {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
}
.bg-img {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}
.gradient-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background: linear-gradient(to bottom, rgba(246,246,246,0) 0%, rgba(246,246,246,1) 100%);
  z-index: 2;
}
.user-info-card {
  position: absolute;
  top: 80rpx;
  left: 0;
  width: 100%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar.logged-in {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}
.nickname {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4); 
}
.user-bio {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.content-section {
  padding: 30rpx;
  background-color: #f6f6f6;
  min-height: 60vh;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333333;
}
.empty-tips {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  margin-top: 80rpx;
}

/* 动态卡片复用 */
.post-list { margin-top: 10rpx; }
.post-card {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.post-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.post-nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}
.post-content { margin-bottom: 20rpx; }
.post-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  word-break: break-all;
}
.text-clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.expand-btn {
  font-size: 28rpx;
  color: #576b95;
  margin-top: 10rpx;
  display: inline-block;
}
.post-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.grid-img {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
}
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f9f9f9;
}
.post-date {
  font-size: 24rpx;
  color: #999999;
}
.action-right { display: flex; align-items: center; }
.action-btn { display: flex; align-items: center; }
.action-emoji { font-size: 32rpx; margin-right: 8rpx; }
.action-num { font-size: 24rpx; color: #666666; }