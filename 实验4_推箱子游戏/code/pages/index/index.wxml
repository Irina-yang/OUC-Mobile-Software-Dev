<view class="container">
  <view class="header-title">游戏选关</view>

  <!-- 关卡网格 -->
  <view class="level-grid">
    <view class="level-card" wx:for="{{levels}}" wx:key="index" bindtap="goToGame" data-level="{{index}}">
      <view class="level-cover">
        <!-- 确保这里的 class 严格对应 -->
        <image class="cover-img" src="/images/icons/house.png" mode="aspectFit"></image>
      </view>
      <text class="level-text">第 {{index + 1}} 关</text>
    </view>
  </view>

  <!-- 排行榜入口 -->
  <button class="leaderboard-btn" bindtap="goToLeaderboard">查看排行榜</button>
</view>