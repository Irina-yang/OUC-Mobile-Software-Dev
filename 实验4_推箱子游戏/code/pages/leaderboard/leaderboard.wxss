.header-title {
  font-size: 50rpx;
  font-weight: 900;
  color: var(--text-main);
  margin-bottom: 40rpx;
  letter-spacing: 2rpx;
}

/* 顶部授权卡片 */
.auth-card {
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(135deg, #ffffff, #fff5f8);
  padding: 30rpx;
  border-radius: 30rpx;
  margin-bottom: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(235, 162, 196, 0.3);
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(235, 162, 196, 0.2);
}

/* 强制重置 button 样式 */
.avatar-wrapper {
  padding: 0 !important;
  margin: 0 30rpx 0 0 !important;
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50% !important;
  background: none !important;
  flex-shrink: 0; /* 绝对禁止被挤压 */
}
.avatar-wrapper::after {
  border: none;
}

.auth-icon {
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50%;
  display: block;
}

.auth-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 防止文字溢出 */
}

.auth-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.nickname-input {
  font-size: 28rpx;
  color: var(--primary-color);
  border-bottom: 2rpx solid rgba(235, 162, 196, 0.3);
  padding-bottom: 4rpx;
}

.nickname-text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.auth-btn {
  margin: 0 0 0 20rpx !important;
  background-color: var(--primary-color);
  color: #fff;
  font-size: 26rpx;
  border-radius: 50rpx;
  padding: 0 30rpx !important;
  height: 60rpx;
  line-height: 60rpx;
  flex-shrink: 0;
}

/* 榜单列表区 */
.board-list {
  width: 100%;
}

.board-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 24rpx 30rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}

.board-item.top-three {
  background: linear-gradient(to right, #ffffff, #fffafb);
  border-left: 8rpx solid var(--primary-color);
}

.rank-medal, .rank-num {
  font-size: 46rpx;
  width: 70rpx;
  text-align: center;
  flex-shrink: 0;
}
.rank-num {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text-sub);
}

/* 榜单头像防爆锁 */
.player-avatar {
  width: 90rpx !important;
  height: 90rpx !important;
  border-radius: 50%;
  margin: 0 24rpx 0 10rpx;
  flex-shrink: 0;
  display: block;
}

.player-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 6rpx;
  white-space: nowrap; /* 强制文字不换行 */
  text-overflow: ellipsis;
  overflow: hidden;
}

.level-tag {
  font-size: 22rpx;
  color: #ffffff;
  background-color: var(--text-sub);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  align-self: flex-start;
}

.score {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-sub);
  flex-shrink: 0;
}

.score-num {
  font-size: 44rpx;
  color: var(--primary-color);
  font-weight: 900;
}