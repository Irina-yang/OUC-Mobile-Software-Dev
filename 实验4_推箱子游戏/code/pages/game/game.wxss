page {
  overflow: hidden;
}
.game-canvas {
  width: 320px;
  height: 320px;
  background-color: #ffffff;
  border: 4rpx solid var(--primary-color);
  border-radius: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(235, 162, 196, 0.3);
  margin-bottom: 60rpx;
}

.control-pad {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.horizontal-btns {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 10rpx;
}

.dir-btn {
  width: 100rpx !important;
  height: 100rpx;
  margin: 10rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background-color: var(--primary-color);
  color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 16rpx rgba(235, 162, 196, 0.4);
}

.restart-btn {
  width: 60% !important;
  background-color: var(--text-main);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
}
.header-info {
  display: flex;
  justify-content: space-between;
  width: 320px;
  align-items: center;
}
.step-counter {
  font-size: 32rpx;
  color: var(--text-main);
  font-weight: bold;
  margin-bottom: 40rpx;
}
.action-btns {
  display: flex;
  width: 80%;
  justify-content: space-between;
}
.sub-btn {
  width: 45% !important;
  background-color: var(--text-sub);
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
}
.sub-btn.restart {
  background-color: var(--text-main);
}